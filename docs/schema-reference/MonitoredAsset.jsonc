{
  "name": "MonitoredAsset",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Trading pair symbol (e.g. BTCUSDT)"
    },
    "display_name": {
      "type": "string",
      "description": "Human readable name (e.g. BTC/USDT)"
    },
    "exchange": {
      "type": "string",
      "enum": [
        "binance",
        "bybit",
        "coinbase"
      ],
      "default": "binance",
      "description": "Data source exchange"
    },
    "market": {
      "type": "string",
      "enum": [
        "crypto",
        "forex",
        "stocks"
      ],
      "default": "crypto",
      "description": "Market type for future expansion"
    },
    "market_type": {
      "type": "string",
      "enum": [
        "spot",
        "futures"
      ],
      "default": "spot",
      "description": "Binance market segment for this asset. Defaults to 'spot' so the GitHub Actions cron (which always fetches from Binance Spot, see scripts/adminMarketDataProvider.js) keeps its existing behavior unchanged. The browser panel fetches Binance Futures (src/lib/marketDataProvider.js) regardless of this flag — it's informational metadata for now (tick size / lot size differ between Spot and Futures), not a provider switch."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this asset is being monitored"
    },
    "timeframes_enabled": {
      "type": "object",
      "description": "Which timeframes are active for this asset",
      "properties": {
        "1h": {
          "type": "boolean",
          "default": true
        },
        "4h": {
          "type": "boolean",
          "default": true
        },
        "1d": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "rf_period": {
      "type": "number",
      "default": 20,
      "description": "Range Filter swing period"
    },
    "rf_multiplier": {
      "type": "number",
      "default": 3.5,
      "description": "Range Filter swing multiplier"
    },
    "rsi_period": {
      "type": "number",
      "default": 14,
      "description": "RSI calculation period. Overrides the Pine-synced rsiLen when set; falls back to it (not a hardcoded literal) when absent — see resolveIndicatorParams in src/lib/scanner.js"
    },
    "rsi_overbought": {
      "type": "number",
      "default": 70,
      "description": "RSI overbought threshold. Until 2026-07-19 (known-risks item 30) this field was saved by AssetConfigPanel but never read by calculateRSI, which hardcoded 70 — editing it had zero effect. Now read via resolveRsiZoneThresholds (src/lib/scanner.js), which validates the PAIR atomically: an invalid pair (inverted, out of (0,100), or only one side set) falls back to the full 70/30 default, never a partial mix"
    },
    "rsi_oversold": {
      "type": "number",
      "default": 30,
      "description": "RSI oversold threshold. Same resolveRsiZoneThresholds pair validation as rsi_overbought — see that field's description"
    },
    "macd_fast": {
      "type": "number",
      "default": 12,
      "description": "MACD fast period"
    },
    "macd_slow": {
      "type": "number",
      "default": 26,
      "description": "MACD slow period"
    },
    "macd_signal": {
      "type": "number",
      "default": 9,
      "description": "MACD signal period"
    },
    "ema_short": {
      "type": "number",
      "default": 20,
      "description": "Short EMA period. Overrides the Pine-synced emaFastLen when set; falls back to it (not a hardcoded literal) when absent — see resolveIndicatorParams in src/lib/scanner.js. Was documented/defaulted as 9 until 2026-07-18 (known-risks item 27), which diverged from the actual Pine script (20)"
    },
    "ema_long": {
      "type": "number",
      "default": 50,
      "description": "Long EMA period. Overrides the Pine-synced emaSlowLen when set; falls back to it (not a hardcoded literal) when absent — see resolveIndicatorParams in src/lib/scanner.js. Was documented/defaulted as 21 until 2026-07-18 (known-risks item 27), which diverged from the actual Pine script (50)"
    },
    "alert_cooldown_minutes": {
      "type": "number",
      "default": 60,
      "description": "Minimum minutes between same type alerts"
    },
    "notify_sources": {
      "type": "array",
      "items": { "type": "string", "enum": ["range_filter", "smc_structure", "macd", "ema_cross", "rsi"] },
      "description": "Per-asset override of which signal sources notify for THIS asset — takes full precedence over the global telegramFilters/current sources when set (not merged/intersected). Absent/null = inherit the global filter, same non-breaking default as every other flag in this project. Read in src/lib/telegram.js and scripts/adminTelegram.js's shouldSend, only for the signal_detected event. See docs/known-risks.md item 47."
    },
    "notify_signal_types": {
      "type": "array",
      "items": { "type": "string", "enum": ["BUY", "SELL"] },
      "description": "Per-asset override of which side (BUY/SELL) notifies for THIS asset — same precedence/scope rules as notify_sources. Absent/null = inherit the global signal_types filter."
    },
    "last_scan_at": {
      "type": "string",
      "description": "ISO timestamp of last scan"
    },
    "scan_status": {
      "type": "string",
      "enum": [
        "idle",
        "scanning",
        "success",
        "error"
      ],
      "default": "idle",
      "description": "Current scan status. 'scanning' is legacy: the transient per-pass write was removed (quota waste, no UI consumer) — new docs only ever hold idle/success/error"
    },
    "scan_error": {
      "type": "string",
      "description": "Last scan error message if any"
    },
    "scan_error_since": {
      "type": "string",
      "description": "ISO timestamp of when scan_status first became 'error' in the current streak (null once it recovers to 'success'). last_scan_at alone can't detect a persistently-failing asset — it's refreshed on every pass regardless of success/error — so this field is what the per-asset healthcheck (scripts/run-scan.mjs) actually alerts on. See docs/known-risks.md item 12."
    },
    "stale_alert_sent_at": {
      "type": "string",
      "description": "ISO timestamp set by the per-asset healthcheck (scripts/run-scan.mjs) when it sends a Telegram alert for this asset, so the 5-minute cron doesn't repeat the same alert every pass. Cleared back to null once the asset recovers, so a future episode alerts again."
    },
    "smc_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Turns on the independent SMC/ICT 1h→5m entry cascade (structure BOS/CHoCH bias on 1h, liquidity sweep or 5m BOS/CHoCH as entry trigger) for this asset. A fully separate cascade from the 4h/15m Range Filter one, never overrides it. `default: false` is both the schema fallback (field absent) and what AddAssetForm.jsx now writes explicitly on every NEW asset (reverted 2026-08-02, docs/known-risks.md item 56 — measured negative expectancy, -0.778R/11 ops/year, plus it frees the assetActiveOps slot shared with RF; between 2026-07-19 and 2026-08-02 new assets got `true` here instead). Assets created in that window keep whatever was written at creation time — this default change is not retroactive; toggle per-asset in AssetConfigPanel ('Cascata SMC/ICT' → 'Ativar cascata 1H → 5M') if you want it off on an existing asset. See docs/known-risks.md item 9 for the caveat: engineering-validated (synthetic tests), not yet compared side-by-side with real TradingView output."
    },
    "smc_confirm_4h15m": {
      "type": "boolean",
      "default": false,
      "description": "When true, adds an extra confirmation gate to the EXISTING 4h/15m Range Filter cascade: the 4h SMC structure trend and Premium/Discount zone must agree with the RF signal direction before a TradeOperation is created. Unlike smc_enabled (purely additive — a separate cascade), this one is NOT additive: it makes the main RF cascade stricter, filtering out RF signals whose 4h SMC structure/zone disagrees. `default: false` is both the schema fallback (field absent) and what AddAssetForm.jsx writes on every NEW asset as of 2026-08-20 (docs/known-risks.md item 108 — real A/B via backtest.yml, 7 symbols/12 months, measured this gate rejecting 100% of the candidates that survived the regime filter, zeroing the RF cascade's operation count in that sample; the same day, the 10 real production assets were switched from `true` to `false` too). Between 2026-07-19 and 2026-08-20, AddAssetForm.jsx wrote `true` here instead (at the user's request, before the A/B evidence existed) — assets created in that window keep whatever was written at creation time, this default change is not retroactive. Toggle per-asset in AssetConfigPanel ('SMC confirm 4h→15m') if you want it on for a specific asset to test. Same known-risks.md item 9 caveat applies (engineering-validated, not yet compared side-by-side with real TradingView output)."
    },
    "backfill_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "done",
        "error"
      ],
      "description": "Drives scripts/run-backfill-check.mjs (docs/known-risks.md item 137). AddAssetForm.jsx writes 'pending' on every NEW asset, and Assets.jsx writes it again on reactivation (is_active false→true) — both mean 'check whether the RF 4h/15m cascade would already have an operation open on this asset, using real recent history'. The scan.yml cron picks up 'pending' assets, runs the real engine (backtestEngine.js:runBacktest) against production over the last 60 days, tags any newly-created TradeOperation source:'backfill', then writes 'done' (or 'error' + backfill_check_error on failure). Absent = never checked (assets created before this field existed)."
    },
    "backfill_checked_at": {
      "type": "string",
      "description": "ISO timestamp of the last backfill check completion (success or error). See backfill_check_status."
    },
    "backfill_ops_found": {
      "type": "number",
      "description": "How many TradeOperation docs the last backfill check tagged source:'backfill' for this asset — 0 is a normal, common outcome (no signal was active in the lookback window). See backfill_check_status."
    },
    "backfill_check_error": {
      "type": "string",
      "description": "Error message from the last backfill check, when backfill_check_status is 'error' (e.g. Binance rejected the symbol, network failure). Truncated to 500 chars."
    }
  },
  "required": [
    "symbol",
    "display_name"
  ]
}