{
  "name": "TradeOperation",
  "type": "object",
  "properties": {
    "symbol": {
      "type": "string",
      "description": "Trading pair symbol"
    },
    "asset_id": {
      "type": "string",
      "description": "Reference to MonitoredAsset"
    },
    "timeframe": {
      "type": "string",
      "description": "Entry-confirmation candle (15m for the 4h/15m cascade, 5m for the 1h/5m SMC cascade)",
      "enum": [
        "1h",
        "4h",
        "1d",
        "15m",
        "5m"
      ]
    },
    "signal_timeframe": {
      "type": "string",
      "description": "Timeframe of the signal/bias candle that originated this operation (4h for the RF cascade, 1h for the SMC cascade) — used to look up the right indicator data during the TP/stop update loop, since `timeframe` above is the entry-confirmation candle, not the signal candle. Absent on legacy ops created before this field existed (all from the 4h/15m cascade — treat missing as '4h').",
      "enum": [
        "4h",
        "1h"
      ]
    },
    "cascade": {
      "type": "string",
      "description": "Which entry cascade created this operation",
      "enum": [
        "4h_15m",
        "1h_5m"
      ]
    },
    "side": {
      "type": "string",
      "enum": [
        "BUY",
        "SELL"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "SIGNAL_CONFIRMED",
        "RUNNER_ACTIVE",
        "TP2_HIT",
        "STOP_HIT",
        "INVALIDATED",
        "CLOSED"
      ],
      "default": "SIGNAL_CONFIRMED"
    },
    "score": {
      "type": "number",
      "description": "LEGACY field, kept for backward-compat readers (existing UI/backtest code). Set once at creation to the same value as entry_score and NEVER modified afterward by arbitration — see entry_score/current_confidence_score (further down this schema) for the current split between immutable entry quality and mutable current confidence."
    },
    "entry_price": {
      "type": "number"
    },
    "entry_candle_time_15m": {
      "type": "string",
      "description": "ISO timestamp of the close of the real 15m candle that confirmed a 4h RF signal (native 4h_15m cascade). Read by getEntryReferenceTime (src/lib/opExitRules.js) as the P0-c/P0-g temporal guard's entry reference and by the Time Stop. Mutually exclusive with entry_candle_time_5m/entry_candle_time_4h — an op has at most one of the three. Absent when pineConfig.skip15mConfirmationEnabled (known-risks.md item 67) bypassed the 15m step for this op — see entry_candle_time_4h instead."
    },
    "entry_candle_time_5m": {
      "type": "string",
      "description": "ISO timestamp of the close of the real 5m candle that confirmed a 1h SMC structure signal (1h_5m cascade). Same role as entry_candle_time_15m, for the SMC cascade."
    },
    "entry_candle_time_4h": {
      "type": "string",
      "description": "known-risks.md item 67 — ISO timestamp of the close of the 4h signal candle itself, recorded ONLY when pineConfig.skip15mConfirmationEnabled bypassed check15mConfirmation for this op (mirrors the user's real Pine strategy, which enters at the signal candle's own close, with no smaller-timeframe confirmation). Read by the same getEntryReferenceTime fallback as entry_candle_time_15m/_5m — a less precise entry reference (the signal candle itself, not a dedicated confirming candle), by design."
    },
    "skip_15m_confirmation": {
      "type": "boolean",
      "description": "known-risks.md item 67 — true only when this op was created with pineConfig.skip15mConfirmationEnabled on (frozen at creation, same pattern as partial_percent/runnerEnabled — a later flag flip governs only the NEXT operation). Absent/undefined on every op created before this field existed or with the gate off."
    },
    "atr_value": {
      "type": "number"
    },
    "initial_stop": {
      "type": "number"
    },
    "current_stop": {
      "type": "number"
    },
    "tp1": {
      "type": "number"
    },
    "tp2": {
      "type": "number"
    },
    "tp1_hit": {
      "type": "boolean",
      "default": false
    },
    "tp2_hit": {
      "type": "boolean",
      "default": false
    },
    // Frozen at creation from pineConfig.disableTp2CapEnabled (backtest-only,
    // docs/known-risks.md item 114) — same contract as pre_tp1_stop_protection_enabled
    // below. When true, both exit loops ignore tp2 entirely: the runner only
    // ever ends in STOP_HIT/INVALIDATED/CLOSED, matching the real Pine
    // (no fixed second target after TP1, trailing-only). tp2/tp2_hit are
    // still computed/stored as usual for display/audit even when this is true.
    "tp2_cap_disabled": {
      "type": "boolean",
      "default": false
    },
    "tp1_hit_at": {
      "type": "string",
      "description": "ISO timestamp when the scan/price-check PASS DETECTED TP1 was hit (wall clock, can lag the real market moment by up to a scan cadence — or much more after a cron gap). See tp1_hit_real_time for the real market time."
    },
    "tp1_hit_real_time": {
      "type": "string",
      "description": "ISO timestamp of the CLOSE of the candle whose high/low confirmed TP1 was touched (only set for candle-based exits in persistScanResults, not the price-check tick loop, which has no candle to reference — docs/known-risks.md item 106/107 follow-up, 'horário real do alerta'). This is an UPPER BOUND, not the exact intrabar cross — only OHLC is available, no tick data within the candle, so the true touch could be up to one candle's duration earlier. Still far more accurate than tp1_hit_at during a cron gap. Prefer this over tp1_hit_at for display, labeled as the candle time (not implying tick-level precision); falls back to null on tick-based exits and on ops created before this field existed."
    },
    "tp1_hit_price": {
      "type": "number",
      "description": "Exact price when TP1 was hit"
    },
    "tp2_hit_at": {
      "type": "string",
      "description": "ISO timestamp when the scan/price-check PASS DETECTED TP2 was hit (wall clock). See tp2_hit_real_time for the real market time."
    },
    "tp2_hit_real_time": {
      "type": "string",
      "description": "ISO timestamp of the CLOSE of the candle whose high/low confirmed TP2 was touched — an upper bound, not the exact intrabar cross (candle-based exits only — see tp1_hit_real_time for the full caveat)."
    },
    "tp2_hit_price": {
      "type": "number",
      "description": "Exact price when TP2 was hit"
    },
    "stop_hit_at": {
      "type": "string",
      "description": "ISO timestamp when the scan/price-check PASS DETECTED the stop was hit (wall clock). See stop_hit_real_time for the real market time."
    },
    "stop_hit_real_time": {
      "type": "string",
      "description": "ISO timestamp of the CLOSE of the candle whose high/low confirmed the stop was touched — an upper bound, not the exact intrabar cross (candle-based exits only — see tp1_hit_real_time for the full caveat). Absent on price-check tick-based stops, where the wall-clock stop_hit_at already IS the real time at that loop's resolution."
    },
    "stop_hit_price": {
      "type": "number",
      "description": "Exact price when stop was hit"
    },
    "exit_ambiguous": {
      "type": "boolean",
      "description": "Set true only on a STOP_HIT whose closed candle ALSO touched the target level (TP1 pre-TP1, TP2 post-TP1) — OHLC alone can't order the two intrabar, so the stop-wins policy (industry-standard conservative assumption, see docs/known-risks.md) was applied under real ambiguity, not as an unambiguous stop. Absent/false on a clean stop."
    },
    "closed_at": {
      "type": "string",
      "description": "ISO timestamp when the scan PASS DETECTED/wrote the terminal close (wall clock). See closed_at_real_time for the real market time."
    },
    "closed_at_real_time": {
      "type": "string",
      "description": "ISO timestamp of the real event that triggered this terminal close (candle-based exits only). Precision varies by closed_reason: for INVALIDATION and CHOP_EXIT the decision is evaluated directly against the candle's CLOSE price, so this is exact; for STOP_HIT and TP1_FULL (intrabar high/low touch) it's the candle's close as an UPPER BOUND, not the exact cross (see tp1_hit_real_time); for TIME_STOP it's the computed deadline instant (entry time + tier_time_stop_bars candles), which is exact and deliberately NOT the latest candle's close (Codex review, PR #213 — Time Stop fires off wall-clock age, not candle state). Prefer this over closed_at for display when present."
    },
    "exit_price": {
      "type": "number",
      "description": "Actual exit price recorded at close time"
    },
    // Frozen at creation. partial_percent is the SINGLE source both the engine
    // (closesFullyAtTp1, opExitRules.js) and the metrics (getWeights,
    // tradeMetrics.js) read — 100 means no runner, so TP1 closes the position
    // (closed_reason TP1_FULL). See docs/known-risks.md item 46.
    "partial_percent": {
      "type": "number",
      "default": 50
    },
    "runner_percent": {
      "type": "number",
      "default": 50
    },
    "exit_mode": {
      "type": "string",
      "enum": [
        "RANGE_FILTER",
        "ATR_TRAILING",
        "HYBRID_RF_ATR"
      ],
      "default": "HYBRID_RF_ATR"
    },
    "candle_open_time": {
      "type": "string",
      "description": "ISO timestamp of candle open"
    },
    "candle_close_time": {
      "type": "string",
      "description": "ISO timestamp of candle close"
    },
    "candle_status": {
      "type": "string",
      "enum": [
        "OPEN",
        "CLOSED"
      ],
      "default": "CLOSED"
    },
    "data_status": {
      "type": "string",
      "enum": [
        "LIVE",
        "STALE",
        "OFFLINE",
        "ERROR"
      ],
      "default": "LIVE"
    },
    "signal_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rf_filter_value": {
      "type": "number"
    },
    "invalidates_if": {
      "type": "string"
    },
    "closed_reason": {
      "type": "string",
      "description": "Set when status is CLOSED/INVALIDATED for a reason other than price hitting stop/TP. TP1_FULL is the exception: price DID hit TP1, and it closed the whole position because the op was created with no runner (partial_percent 100 — runnerEnabled off or tp1QtyPercent 100). See docs/known-risks.md item 46.",
      "enum": [
        "TIME_STOP",
        "CHOP_EXIT",
        "INVALIDATION",
        "TP1_FULL"
      ]
    },
    "tier": {
      "type": "string",
      "description": "Auto-classified volatility tier at entry (ATR% based, see Pine v13.2 Grupo 03)",
      "enum": [
        "T1",
        "T2",
        "T3"
      ]
    },
    "adx_at_entry": {
      "type": "number",
      "description": "ADX value on the signal timeframe at the moment of entry (4h for the RF cascade, always computed; 1h for the SMC cascade, only when pineConfig.smcTierEnabled is on — Fase 3, docs/known-risks.md item 42, off by default)"
    },
    "chop_at_entry": {
      "type": "number",
      "description": "Choppiness Index value on the signal timeframe at the moment of entry (4h for the RF cascade, always computed; 1h for the SMC cascade, only when pineConfig.smcTierEnabled is on — Fase 3, docs/known-risks.md item 42, off by default)"
    },
    "tier_time_stop_bars": {
      "type": "number",
      "description": "Time Stop threshold, in candles of `signal_timeframe` (4h for the RF cascade, from the tier classified at entry; 1h for the SMC cascade, tier-derived when pineConfig.smcTierEnabled is on — Fase 3, docs/known-risks.md item 42 — fixed at 96 otherwise) — not recalculated later even if the asset's tier changes"
    },
    "entry_candle_pattern": {
      "type": ["string", "null"],
      "enum": ["bullish_engulfing", "bearish_engulfing", "hammer", "shooting_star", "bullish_marubozu", "bearish_marubozu", null],
      "description": "Candlestick pattern (src/lib/indicators/candlePatterns.js) that confirmed the signal candle, RF cascade only — first match wins, checked in this priority: engulfing -> pin bar (hammer/shooting_star) -> marubozu. Null when pineConfig.candlePatternEnabled is off (the default) — additional gate on top of the RF signal, not a replacement for it. Requested by the user, 2026-08-02."
    },
    "smc_alignment_at_entry": {
      "type": ["string", "null"],
      "enum": ["aligned", "against", "unavailable", null],
      "description": "RF cascade only, purely observational — classifies whether the SMC structure trend AND Premium/Discount zone agreed with the RF signal's direction at the moment of entry. The zone is measured (classifyZone) against SMC's OWN most recent swing range (lastSwingHigh/lastSwingLow — the confirmed protected pivots, textbook ICT/SMC Premium/Discount definition), not the tautological generic 20-candle window the older asset.smc_confirm_4h15m GATE still uses, and NOT the RF signal candle's own close (a first live A/B, docs/known-risks.md item 77, measured 0 'aligned' in 104 ops when anchored that way — a confirmed 15m entry almost always continues past the signal candle's own close by construction, biasing the zone regardless of real market state; fixed by anchoring to the swing range instead). The leg (SignalEvent.context.smc_align_leg_high/low) is built once when the 4h signal is born and never recomputed on retry — only the trend is re-read live. 'unavailable' when structure pivots aren't formed yet. Never gates or changes entry_score/whether the operation opens — computed only when pineConfig.smcAlignmentScoreEnabled is on (off by default, backtest-only). Purpose: measure whether SMC context helps or just filters out good trades before ever turning it into a score weight or a gate. docs/known-risks.md item 77."
    },
    "rf_reverse_bars_count": {
      "type": "number",
      "description": "Consecutive candles of `signal_timeframe` with Range Filter reversed against the position (pre-TP1 only) — used by the Invalidation toggle",
      "default": 0
    },
    "mfe_r": {
      "type": "number",
      "description": "Maximum Favorable Excursion, in R (same risk denominator as calcRealizedR: |entry_price - initial_stop|). Recomputed on every closed candle of signal_timeframe from that candle's high/low (persistScanResults only — priceCheckActiveOpsInner does NOT update this, candle resolution not tick resolution, a deliberate precision tradeoff to avoid turning a live-price loop into a near-continuous write source). Gated by the same P0-c/P0-g candleUsable guard as stop/TP — a pre-entry candle can never count. known-risks item 47.2."
    },
    "mae_r": {
      "type": "number",
      "description": "Maximum Adverse Excursion, in R — same denominator/source/gating as mfe_r, but tracking the worst point against the position (a negative number). known-risks item 47.2."
    },
    "bars_to_mfe": {
      "type": "number",
      "description": "Bars (of signal_timeframe, elapsed-time proxy — same convention as the Time Stop's barsOpen) since entry when the current mfe_r was set."
    },
    "bars_to_mae": {
      "type": "number",
      "description": "Same as bars_to_mfe, for mae_r."
    },
    "bars_to_tp1": {
      "type": "number",
      "description": "Bars since entry when TP1 was hit — same elapsed-time proxy as bars_to_mfe, stamped once at the tp1_hit transition."
    },
    "bars_to_stop": {
      "type": "number",
      "description": "Bars since entry when the operation stopped out (pre or post TP1) — stamped once at the STOP_HIT transition, absent on ops that never stopped."
    },
    "tf_1d_direction": {
      "type": "number",
      "description": "Multi-timeframe macro alignment (analyzeAlignment's rf_direction, -1/0/1) copied from the originating SignalEvent.context at entry — purely observational, never a gate. Fixed known-risks item 47.2: buildTradeOpData/buildSmcTradeOpData never copied this before, so TradeCard.jsx's existing read of these 3 fields always resolved null on an active operation."
    },
    "tf_4h_direction": {
      "type": "number",
      "description": "Same as tf_1d_direction, 4h timeframe."
    },
    "tf_1h_direction": {
      "type": "number",
      "description": "Same as tf_1d_direction, 1h timeframe."
    },
    "source": {
      "type": "string",
      "enum": [
        "scanner",
        "scanner_smc",
        "tradingview_webhook",
        "manual"
      ],
      "default": "scanner",
      "description": "Whether this operation came from the RF 4h/15m scanner cascade, the SMC 1h/5m scanner cascade, was logged from a real TradingView webhook alert, or was opened by hand from the dashboard's 'Ativar agora' button (activateSignalManually — managed by the RF 4h rules regardless of which signal prompted it, see docs/known-risks.md item 46.5)"
    },
    "bias": {
      "type": "string",
      "description": "SMC cascade only: structure bias that generated the signal",
      "enum": [
        "bullish",
        "bearish"
      ]
    },
    "structure_type": {
      "type": "string",
      "description": "SMC cascade only: whether the 1h signal was a Break of Structure or a Change of Character",
      "enum": [
        "BOS",
        "CHoCH"
      ]
    },
    "pd_zone": {
      "type": "string",
      "description": "SMC cascade only: Premium/Discount/Equilibrium zone on the 1h at signal time",
      "enum": [
        "premium",
        "discount",
        "equilibrium"
      ]
    },
    "sweep_confirmed": {
      "type": "boolean",
      "description": "SMC cascade only: whether the 5m entry trigger was a liquidity sweep (true) or a 5m BOS/CHoCH (false)"
    },
    "stop_basis": {
      "type": "string",
      "enum": [
        "structural",
        "structural_floored",
        "structural_capped",
        "atr_fallback"
      ],
      "description": "SMC cascade only: how the initial stop was derived — structural level with buffer, floored at 0.5×ATR(1h), capped at 2×ATR(1h), or plain ATR fallback (missing/invalid level). See computeStructuralStop in opExitRules.js"
    },
    "structural_level": {
      "type": [
        "number",
        "null"
      ],
      "description": "SMC cascade only: raw 5m invalidation level the stop was derived from (sweep wick or protective swing extreme), before buffer/floor/cap"
    },
    "ote_leg_high": {
      "type": [
        "number",
        "null"
      ],
      "description": "SMC cascade only (known-risks.md item 38): high bound of the OTE leg the 1h structure break anchored — the protected swing high (SELL) or the break's own confirming close (BUY). Observability only, does not feed initial_stop/tp1/tp2 (see structural_level for that)."
    },
    "ote_leg_low": {
      "type": [
        "number",
        "null"
      ],
      "description": "SMC cascade only (known-risks.md item 38): low bound of the OTE leg — mirror of ote_leg_high (the break's own confirming close for SELL, or the protected swing low for BUY)."
    },
    "ote_zone_at_entry": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "premium",
        "discount",
        "equilibrium",
        null
      ],
      "description": "SMC cascade only (known-risks.md item 38): Premium/Discount/Equilibrium zone the 5m entry candle was classified into against the OTE leg — the gate that replaced the old 1h-candle zone gate (item 35)."
    },
    "retest_gate_enabled": {
      "type": "boolean",
      "description": "Fase 2 rodada 1 (known-risks.md item 40): true only when the opt-in retest confirmation gate (pineConfig.retestEnabled, off by default) actually participated in this entry — retest.js's detectRetest confirmed a pullback to the broken level before check15mConfirmation/check5mSmcConfirmation ran. Absent/undefined on every op created before this field existed or with the gate off — never mutates entry_price/initial_stop/tp1/tp2, observability only."
    },
    "retest_anchor_level": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 1: the level retested — SignalEvent.context.rf_value for the RF cascade, SignalEvent.context.smc_broken_level for the SMC cascade. Only present when retest_gate_enabled is true."
    },
    "retest_price": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 1: close (or wick, per retest_touch_mode) of the candle that satisfied the retest, on the confirmation timeframe (15m/5m)."
    },
    "retest_candle_time": {
      "type": ["string", "null"],
      "description": "Fase 2 rodada 1: closeTime of the retest candle (epoch ms, matches the raw candle field — not the ISO strings used elsewhere in this schema)."
    },
    "retest_bars_to_confirm": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 1: number of confirmation-timeframe candles (15m/5m) after the signal candle it took for the retest to confirm — the metric to look at when calibrating retestToleranceAtrMult/timeout via backtest."
    },
    "retest_touch_mode": {
      "type": ["string", "null"],
      "enum": ["close", "wick", null],
      "description": "Fase 2 rodada 1: pineConfig.retestTouchMode value used for this entry's retest evaluation — recorded per-op since the config can change over time."
    },
    "displacement_gate_enabled": {
      "type": "boolean",
      "description": "Fase 2 rodada 2 (known-risks.md item 41): true only when the opt-in displacement gate (pineConfig.displacementEnabled, off by default, SMC 1h→5m cascade only) actually participated in this entry — detectDisplacement (src/lib/indicators/displacement.js) classified the entry trigger candle as a displacement candle before the operation was created. Absent/undefined on every op created before this field existed, with the gate off, or on the RF 4h_15m cascade (out of scope for this round) — never mutates entry_price/initial_stop/tp1/tp2, observability only."
    },
    "displacement_body_ratio": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 2: entry candle's |close-open| divided by ATR(pineConfig.atrLen) on the 5m confirmation timeframe. Only present when displacement_gate_enabled is true."
    },
    "displacement_volume_ratio": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 2: entry candle's volume divided by the volLen-period volume average, only computed when pineConfig.displacementMinVolumeRatio is set (non-null) for this entry — null when the volume requirement was off (pure price-action mode, the default)."
    },
    "displacement_min_body_atr_mult": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 2: pineConfig.displacementBodyAtrMult value used for this entry's evaluation — recorded per-op since the config can change over time."
    },
    "displacement_min_volume_ratio": {
      "type": ["number", "null"],
      "description": "Fase 2 rodada 2: pineConfig.displacementMinVolumeRatio value used for this entry's evaluation (null = volume wasn't required for this entry)."
    },
    "arbitration_outcome": {
      "type": "string",
      "description": "Result of the most recent cross-cascade arbitration decision (src/lib/signalArbitration.js) that actually WROTE to this operation — 'none'-action outcomes (reinforcement_accepted/rejected, continuation_confirmation, candidate_below_arbitration_threshold, no_change) are logged to SystemLog but deliberately do NOT appear here (write economy — nothing on the op changed). Absent when no arbitration decision has ever written to this operation.",
      "enum": [
        "promoted",
        "correction_warning",
        "critical_opposite"
      ]
    },
    "arbitration_reason": {
      "type": "string",
      "description": "Machine-readable reason code for the most recent arbitration_outcome (see src/lib/signalArbitration.js's `reason` values, e.g. candidate_score_meets_promotion_threshold, smaller_timeframe_opposes_active_op)."
    },
    "arbitration_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent arbitration decision applied to this operation."
    },
    "promotion_status": {
      "type": "string",
      "description": "1h_5m cascade only — two-stage promotion state machine (external audit of PR #78: a qualifying 4h candidate alone is NOT sufficient to promote, since arbitration never fetches the 15m candle itself — see src/lib/signalArbitration.js's module doc). NONE/absent until a same-direction 4h candidate scores >= arbPromoteMinScore (-> PENDING_15M); scanner.js's promotion-confirmation retry step then resolves it to CONFIRMED (via the SAME check15mConfirmation the native 4h_15m cascade requires) or EXPIRED (window elapsed, default 4h, without confirmation). A critical_opposite arbitration event (larger-timeframe reversal) while PENDING_15M moves it to REJECTED instead. EXPIRED/REJECTED both allow a fresh PENDING_15M cycle from a NEW candidate signal — they do not permanently block promotion.",
      "enum": [
        "NONE",
        "PENDING_15M",
        "CONFIRMED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "promotion_candidate_at": {
      "type": "string",
      "description": "1h_5m cascade only — ISO timestamp when promotion_status entered PENDING_15M (the qualifying 4h candidate's arrival). Used to compute the confirmation window's expiry."
    },
    "promotion_candidate_score_4h": {
      "type": "number",
      "description": "1h_5m cascade only — the qualifying 4h candidate signal's score at the moment promotion_status entered PENDING_15M."
    },
    "promotion_candidate_signal_id": {
      "type": "string",
      "description": "1h_5m cascade only — dedup_key of the SignalEvent that started the current/most recent PENDING_15M cycle."
    },
    "promotion_confirmed_at": {
      "type": "string",
      "description": "1h_5m cascade only — ISO timestamp when promotion_status reached CONFIRMED (Stage B, the real 15m confirmation)."
    },
    "promotion_confirm_candle_time": {
      "type": "string",
      "description": "1h_5m cascade only — close time of the 15m candle that confirmed the promotion (from check15mConfirmation's entryCandleTime)."
    },
    "trade_mode": {
      "type": "string",
      "description": "1h_5m cascade only — which timeframe's context is currently managing this operation. TACTICAL_1H from creation; flips to PROMOTED_4H only once promotion_status reaches CONFIRMED. The 4h_15m cascade has no equivalent (already the largest timeframe) and leaves this field absent.",
      "enum": [
        "TACTICAL_1H",
        "PROMOTED_4H"
      ]
    },
    "management_timeframe": {
      "type": "string",
      "description": "1h_5m cascade only — mirrors trade_mode as the actual timeframe whose context governs management ('1h' or '4h' once promoted). Absent on 4h_15m-origin operations.",
      "enum": [
        "1h",
        "4h"
      ]
    },
    "origin_cascade": {
      "type": "string",
      "description": "Immutable marker of which cascade created this operation — set once at creation and NEVER changed afterward (unlike `cascade`, which is also never mutated today, but this field exists as an explicit, decoupled guarantee independent of `cascade`'s own semantics).",
      "enum": [
        "4h_15m",
        "1h_5m"
      ]
    },
    "promoted_at": {
      "type": "string",
      "description": "ISO timestamp when this operation was promoted (Stage B / CONFIRMED — conservative promotion only, a management upgrade of this SAME operation, never a second operation). Absent if never promoted. Equivalent to promotion_confirmed_at, kept as a separate field for continuity with earlier tooling."
    },
    "promoted_from_cascade": {
      "type": "string",
      "description": "Cascade this operation originated from, before promotion. Only 1h_5m can be promoted in this phase (promotion is one-directional: 1h op + aligned, 15m-confirmed 4h signal).",
      "enum": [
        "1h_5m"
      ]
    },
    "score_at_promotion_1h": {
      "type": "number",
      "description": "This operation's own entry_score (SMC cascade) at the moment of promotion."
    },
    "score_at_promotion_4h": {
      "type": "number",
      "description": "The promoting 4h candidate signal's score at the moment its PENDING_15M cycle started (promotion_candidate_score_4h)."
    },
    "entry_score": {
      "type": "number",
      "description": "0-100 confluence score AT ENTRY — immutable for audit, never modified after creation by anything (including cross-cascade arbitration's reduce_confidence action). Mirrors the legacy `score` field's value at creation time. Absent on operations created before this field existed — readers should fall back to `score`."
    },
    "current_confidence_score": {
      "type": "number",
      "description": "0-100, starts equal to entry_score at creation — the ONLY score field cross-cascade arbitration's reduce_confidence action is allowed to move (clamped 0-100). Represents current confidence, distinct from the immutable entry_score. Absent on operations created before this field existed — readers should fall back to entry_score, then score."
    },
    "confidence_penalty_total": {
      "type": "number",
      "description": "Cumulative sum of all confidence penalties ever applied to this operation via reduce_confidence, for audit (entry_score - current_confidence_score should equal this, modulo the 0-floor clamp).",
      "default": 0
    },
    "last_opposing_signal_at": {
      "type": "string",
      "description": "ISO timestamp of the most recent opposing-signal arbitration event that reduced current_confidence_score."
    },
    "rr_at_entry": {
      "type": "number",
      "description": "Risk:Reward ratio (distance to the chosen target / distance to stop) computed by passesRiskReward (src/lib/opExitRules.js) at entry time. See rr_gate_mode for what this number actually measures today."
    },
    "rr_gate_mode": {
      "type": "string",
      "description": "Honesty label for rr_at_entry/passesRiskReward (external audit of PR #78): under BOTH cascades' current TP model, tp1/tp2 are derived as a CONFIGURED multiple of the risk distance (entry ± riskDistance*tp1R/tp2R), not a distance to any real chart level — so rr_at_entry is mathematically ~equal to pineConfig.tp1R/tp2R for every real entry today. This field exists so the panel/audit trail never implies more than that. A future structural (support/resistance/liquidity/swing/FVG/OB-derived) target model would introduce a different value here.",
      "enum": [
        "CONFIGURED_MULTIPLE"
      ]
    },
    "rr_target_basis": {
      "type": "string",
      "description": "Companion to rr_gate_mode — what rr_at_entry's target distance is actually derived from.",
      "enum": [
        "R_MULTIPLE"
      ]
    },
    "market_source": {
      "type": "string",
      "description": "Which Binance market this operation's data came from — 'futures' when created by the browser panel, 'spot' when created by the 24h cron (see docs/known-risks.md item 4's accepted Spot/Futures divergence). Makes explicit what was previously only implicit in which executor ran.",
      "enum": [
        "spot",
        "futures"
      ]
    },
    "data_exchange": {
      "type": "string",
      "description": "Exchange the candle/price data came from.",
      "default": "binance"
    },
    "executor": {
      "type": "string",
      "description": "Which process created this operation.",
      "enum": [
        "browser",
        "cron"
      ]
    },
    "pre_tp1_stop_protection_enabled": {
      "type": "boolean",
      "description": "known-risks.md items 53/54 — true only when the opt-in pre-TP1 stop protection gate (pineConfig.preTp1StopProtectionEnabled, off by default) was on when this operation was created. Frozen at creation (same reasoning as partial_percent/runnerEnabled) — read by persistScanResults instead of pineConfig directly, so a later flag flip governs only the NEXT operation, never a position already in flight. When true, advancePreTp1StopProtection (src/lib/opExitRules.js) may move current_stop to breakeven BEFORE TP1 once price has moved favorably by pre_tp1_stop_advance_trigger_atr_mult × ATR — otherwise the pre-TP1 stop stays exactly at initial_stop, today's default behavior."
    },
    "pre_tp1_stop_advance_trigger_atr_mult": {
      "type": "number",
      "description": "known-risks.md items 53/54 — pineConfig.preTp1StopProtectionAtrMult value used for this entry's evaluation, recorded per-op since the config can change over time (same pattern as retest_touch_mode/displacement_min_body_atr_mult). Only meaningful when pre_tp1_stop_protection_enabled is true, AND pre_tp1_stop_mode is 'breakeven'."
    },
    "pre_tp1_stop_mode": {
      "type": "string",
      "enum": ["breakeven", "trailing"],
      "description": "known-risks.md item 132 — WHICH pre-TP1 mechanism governs this operation, frozen at creation from pineConfig.preTp1TrailEnabled (same contract as partial_percent/runnerEnabled: a later flag flip governs only the NEXT operation). Absent or 'breakeven' = the original mechanism (advancePreTp1StopProtection: a binary jump to entry that SATURATES there). 'trailing' = advancePreTp1Trailing: a continuous trail anchored on the favourable EXTREME since entry (reconstructed from mfe_r via favorableExtremeFromMfe), which stays FURTHER from price than breakeven while the move is young and keeps climbing past breakeven once it proves itself. Mutually exclusive — only one runs. Both require pre_tp1_stop_protection_enabled: that flag opens the pre-TP1 block, this one picks the mechanism inside it."
    },
    "pre_tp1_trail_start_atr_mult": {
      "type": "number",
      "description": "known-risks.md item 132 — pineConfig.preTp1TrailStartAtrMult recorded per-op (same pattern as pre_tp1_stop_advance_trigger_atr_mult). How far price must move favourably, in ATR multiples, before the trail arms at all. Deliberately generous: a trail seeded at entry would tighten the stop on the very first bar, the opposite of the premature-breakeven whipsaw lesson of item 53. Only meaningful when pre_tp1_stop_mode is 'trailing'."
    },
    "pre_tp1_trail_atr_mult": {
      "type": "number",
      "description": "known-risks.md item 132 — pineConfig.preTp1TrailAtrMult recorded per-op. Distance from the favourable extreme to the trailed stop, in ATR multiples. Only meaningful when pre_tp1_stop_mode is 'trailing'."
    },
    "pre_tp1_stop_advanced_at": {
      "type": "string",
      "description": "known-risks.md items 53/54 — ISO timestamp when advancePreTp1StopProtection first moved current_stop to breakeven, pre-TP1. Absent when the gate never fired (flag off, or price never moved favorably enough before TP1/stop)."
    },
    "pre_tp1_stop_advanced_candle_time": {
      "type": "string",
      "description": "known-risks.md items 53/54 (Codex review, PR #106, P1) — raw closeTime (epoch ms, matches tfData.lastCandleTime) of the candle whose close triggered the last pre-TP1 stop advance. The cron re-evaluates the SAME still-latest-closed candle many times before a genuinely new one closes; excluding this candle from the stop-hit check on repeat passes prevents a look-ahead false STOP_HIT against the just-advanced stop using data already safely evaluated against the OLD stop. Absent when the gate never fired."
    },
    "runner_stop_advanced_candle_time": {
      "type": "string",
      "description": "known-risks.md item 59 — same look-ahead fix as pre_tp1_stop_advanced_candle_time (Codex PR #106, P1), applied to the POST-TP1 ATR trailing stop (P0-d, advanceTrailingStop), which had never received it despite sharing the identical multi-pass-same-candle vulnerability. Raw closeTime (epoch ms, matches tfData.lastCandleTime) of the candle whose close last advanced current_stop while the op was RUNNER_ACTIVE; excludes that candle from the runner's stop-hit check on repeat passes within the same candle. Unlike the pre-TP1 field (fires once, then stays at breakeven), this overwrites on every genuine advance since the trail can tighten repeatedly over the op's life. Absent on ops that never used ATR trailing (exit_mode HYBRID_RF_ATR/ATR_TRAILING) or whose stop never advanced post-TP1."
    }
  },
  "required": [
    "symbol",
    "timeframe",
    "side",
    "entry_price"
  ]
}