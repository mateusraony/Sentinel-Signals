col_pwl               = input.color (color.new(#66bb6a, 0), 'PWL'                    , group=g_levels, inline='wl')
show_key_labels       = input.bool  (true    , 'Show Level Labels'                   , group=g_levels)

var g_candle          = 'Candle Coloring'
show_candle_color     = input.bool  (false   , 'Color Candles by Trend'              , group=g_candle)
