showS1Lb     = input.bool  (true   , 'Labels'                                      , group=g_s1, inline='f0')
colS1Up      = input.color (#089981, 'Bullish'                                     , group=g_s1, inline='f1')
colS1Dn      = input.color (#f23645, 'Bearish'                                     , group=g_s1, inline='f1')
styS1In      = input.string('Dotted', 'Style', options=['Solid','Dashed','Dotted']  , group=g_s1, inline='f3')
szS1In       = input.string('Small' , ''     , options=['Tiny','Small','Normal','Large','Huge'], group=g_s1, inline='f3')
widS1        = input.int   (2      , '', minval=1                                   , group=g_s1, inline='f3')

var g_s2     = 'Adaptive High/Low Structure'
