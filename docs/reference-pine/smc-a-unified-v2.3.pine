bull_css         = input.color (#089981, ''                                                    , group=g_struct, inline='b')
show_bear        = input.string('All'  , 'Bearish', options=['All','BOS','CHoCH']              , group=g_struct, inline='br')
bear_css         = input.color (#f23645, ''                                                    , group=g_struct, inline='br')
