col_london       = input.color (color.new(#2196f3, 93), 'Londres  23h-02h (Brasília)'    , group=g_sess, inline='lo')
col_newyork      = input.color (color.new(#ff5722, 93), 'Nova York  04h-07h (Brasília)'  , group=g_sess, inline='ny')

/////////////////////////////////////////////////////////////////////////////////
