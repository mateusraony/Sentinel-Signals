show_bull_choch  = show_Structure and (show_bull == 'All' or show_bull == 'CHoCH')
show_bear_bos    = show_Structure and (show_bear == 'All' or show_bear == 'BOS')
show_bear_choch  = show_Structure and (show_bear == 'All' or show_bear == 'CHoCH')

var g_ob                 = 'Order Blocks'
