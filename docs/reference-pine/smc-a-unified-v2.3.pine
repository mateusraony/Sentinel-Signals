bear_ob_css_line         = input.color (color.new(#f925eb, 15)   , ''                              , group=g_ob, inline='OB')
ob_showlast              = input.int   (2                         , 'Show last', minval=1           , group=g_ob, inline='OB')
ob_filter_min_mult       = input.float (0.5                       , 'Size Filter Min (ATR x)', minval=0, step=0.1, group=g_ob, inline='OBf')
ob_filter_max_mult       = input.float (2.5                       , 'Max'                    , minval=1, step=0.1, group=g_ob, inline='OBf')
ob_extend_until_broken   = input.bool  (true                      , 'Extend until broken'          , group=g_ob)
ob_keep_broken           = input.bool  (true                      , 'Keep broken'                   , group=g_ob, inline='kb')
ob_keep_broken_max       = input.int   (1                         , '', minval=0                    , group=g_ob, inline='kb')
bull_ob_css_broken       = input.color (color.new(color.gray, 90) , ''                              , group=g_ob, inline='kb')
bear_ob_css_broken       = input.color (color.new(color.gray, 90) , ''                              , group=g_ob, inline='kb')
bull_ob_line_css_broken  = color.new(bull_ob_css_broken, 50)
bear_ob_line_css_broken  = color.new(bear_ob_css_broken, 50)
use_ob_soft_confirm      = input.bool  (true , 'Use soft confirm'             , group=g_ob)
use_retr_with_fvg_out    = input.bool  (true , 'Use retracements with FVG out', group=g_ob)
// NOVO v2.3: input para controlar como OB é quebrado — por wick ou por fechamento
ob_broken_by             = input.string('Wick (High/Low)', 'OB quebra por',
 options=['Wick (High/Low)', 'Fechamento (Close)'],
 group=g_ob,
 tooltip='Wick: OB é removido quando a sombra toca o break_price (padrão SMC). Fechamento: OB só é removido quando a vela fecha fora do nível — recomendado para ações e forex.')
ob_break_mode            = ob_broken_by == 'Fechamento (Close)' ? LevelBreakMode.CLOSE : LevelBreakMode.HIGHLOW
float soft_confirm_offset = ND.atr(50)

var g_fvg                 = 'Fair Value Gaps'
show_fvg                  = input.bool  (true                     , 'Show FVG'               , group=g_fvg, inline='s')
bull_fvg_css              = input.color (color.new(#00ff68, 90)  , ''                        , group=g_fvg, inline='s')
bear_fvg_css              = input.color (color.new(#ff0008, 90)  , ''                        , group=g_fvg, inline='s')
bull_fvg_line_css         = input.color (color.new(#00ff68, 25)  , ''                        , group=g_fvg, inline='s')
bear_fvg_line_css         = input.color (color.new(#ff0008, 25)  , ''                        , group=g_fvg, inline='s')
fvg_showlast              = input.int   (2                        , 'Show last', minval=1     , group=g_fvg, inline='s2')
fvg_extend_until_filled   = input.bool  (true                     , 'Extend until filled'     , group=g_fvg, inline='ext')
fvg_keep_filled           = input.bool  (true                     , 'Keep filled'             , group=g_fvg, inline='kf')
fvg_keep_filled_max       = input.int   (1                        , '', minval=1              , group=g_fvg, inline='kf')
bull_fvg_css_filled       = input.color (color.new(color.gray,80) , ''                        , group=g_fvg, inline='kf')
bear_fvg_css_filled       = input.color (color.new(color.gray,80) , ''                        , group=g_fvg, inline='kf')
bull_fvg_line_css_filled  = color.new(bull_fvg_css_filled, 50)
bear_fvg_line_css_filled  = color.new(bear_fvg_css_filled, 50)
filter_insig_fvgs         = input.bool  (true , 'Filter min size'  , group=g_fvg, inline='fm')
min_fvg_atr_len           = input.int   (50   , 'ATR Len', minval=1, group=g_fvg, inline='fm')
min_fvg_atr_mult          = input.float (0.5  , 'x', minval=0, step=0.1, group=g_fvg, inline='fm')
fvg_fill_target_ratio     = input.float (60   , 'Filled at %', minval=-100, maxval=200, step=5, group=g_fvg) / 100
float fvg_size_threshold  = filter_insig_fvgs ? ND.atr(min_fvg_atr_len) * min_fvg_atr_mult : 0

var g_htf                 = 'Fair Value Gaps (Higher Timeframe)'
show_htf_fvg              = input.bool      (true , 'Show HTF FVG'           , group=g_htf, inline='s')
fvg_htf                   = input.timeframe ('1D'  , ''                       , group=g_htf, inline='s')
htf_fvg_showlast          = input.int       (1     , 'Show last', minval=1    , group=g_htf, inline='s2')
htf_fvg_keep_filled       = input.bool      (true  , 'Keep filled'            , group=g_htf, inline='kf')
htf_fvg_keep_filled_max   = input.int       (1     , '', minval=1             , group=g_htf, inline='kf')
if barstate.isfirst and show_htf_fvg and timeframe.in_seconds(fvg_htf) < timeframe.in_seconds()
    runtime.error('HTF FVG: selecione um timeframe maior que o atual.')

var g_eq         = 'EQH / EQL'
show_eq          = input.bool  (false, 'Equal High/Low'                              , group=g_eq)
eq_len           = input.int   (3    , 'Bars Confirmation', minval=1                 , group=g_eq)
eq_threshold_in  = input.float (0.1  , 'Threshold', minval=0, maxval=0.5, step=0.1   , group=g_eq)

var g_pd         = 'Premium / Discount Zones'
show_pd          = input.bool  (true    , 'Show P/D Zones'                           , group=g_pd)
pd_swing_len     = input.int   (20      , 'Swing Lookback', minval=5                 , group=g_pd)
col_premium      = input.color (color.new(#f23645, 88), 'Premium'                    , group=g_pd, inline='pc')
col_discount     = input.color (color.new(#089981, 88), 'Discount'                   , group=g_pd, inline='pc')
col_equilibrium  = input.color (color.new(#9b9b9b, 88), 'Equilibrium'                , group=g_pd, inline='pc')
show_pd_labels   = input.bool  (true    , 'Show Labels'                              , group=g_pd)

var g_sw         = 'Liquidity Sweep'
show_sweep       = input.bool  (true    , 'Show Liquidity Sweep'                     , group=g_sw)
sweep_lookback   = input.int   (20      , 'Lookback', minval=5                       , group=g_sw)
col_sweep_bull   = input.color (#00e676 , 'Bullish Sweep'                            , group=g_sw, inline='sc')
col_sweep_bear   = input.color (#ff1744 , 'Bearish Sweep'                            , group=g_sw, inline='sc')
show_sweep_label = input.bool  (true    , 'Show Labels'                              , group=g_sw)

var g_conf       = 'Confluence Score'
show_conf        = input.bool  (true    , 'Show Confluence Score'                    , group=g_conf)
conf_pos         = input.string('Top Right', 'Position', options=['Top Right','Top Left','Bottom Right','Bottom Left'], group=g_conf)

var g_levels          = 'Key Levels (PDH/PDL/PWH/PWL)'
show_daily_levels     = input.bool  (true    , 'Show Daily Levels (PDH/PDL)'         , group=g_levels)
show_weekly_levels    = input.bool  (true    , 'Show Weekly Levels (PWH/PWL)'        , group=g_levels)
col_pdh               = input.color (color.new(#ef5350, 0), 'PDH'                    , group=g_levels, inline='dl')
