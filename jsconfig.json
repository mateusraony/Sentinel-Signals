{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["esnext", "dom"],
    "target": "esnext",
    "checkJs": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "src/components/**/*.js",
    "src/components/**/*.jsx",
    "src/pages/**/*.js",
    "src/pages/**/*.jsx",
    "src/lib/**/*.js",
    "src/lib/**/*.jsx",
    "src/api/**/*.js",
    "src/api/**/*.jsx",
    "src/hooks/**/*.js",
    "src/hooks/**/*.jsx",
    "src/Layout.jsx",
    "src/vite-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/components/ui",
    "**/*.test.js",
    "**/*.test.jsx"
  ]
} 