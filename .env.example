# Firebase Web App config (Console Firebase > Configurações do projeto > Seus apps).
# Estas são chaves públicas do client SDK (não secrets) — hoje também vivem em
# render.yaml para o deploy do Render, mantidas aqui para rodar localmente.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# URL do Realtime Database (Console Firebase > Realtime Database > criar
# banco). Espelho de LEITURA do Firestore para o polling do dashboard
# (docs/known-risks.md item 152) — opcional: sem esta var, o app funciona
# 100% em Firestore como antes (guard em src/lib/firebaseClient.js).
VITE_FIREBASE_DATABASE_URL=

# URL pública do server/ (sentinel-signals-api no Render) — usado por
# src/lib/apiBackend.js para chamar rotas autenticadas do backend (hoje:
# /api/telegram-notify e /api/backtest/*). Também é uma chave pública (a URL
# do próprio serviço), não um secret.
VITE_BACKEND_URL=

# ─────────────────────────────────────────────────────────────
# As variáveis abaixo NÃO são usadas pelo frontend (Vite só expõe
# vars com prefixo VITE_). São secrets de outros contextos deste
# repo — nunca coloque valores reais neste arquivo, ele é versionado.
#
# scripts/run-scan.mjs (npm run scan / GitHub Actions "Scheduled scan"):
#   FIREBASE_SERVICE_ACCOUNT_JSON  — JSON da service account do Firebase Admin SDK
#   TELEGRAM_BOT_TOKEN             — token do bot (canal 24h, fora do browser)
#   TELEGRAM_CHAT_ID               — chat_id de destino do canal 24h
#   HEALTHCHECKS_PING_URL          — opcional; URL de "ping" do healthchecks.io
#                                    (ou serviço compatível) usada como watchdog —
#                                    avisa via Telegram se o scan parar de rodar
#                                    de verdade. Ver docs/known-risks.md item 12.
#
# server/ (Express, deployado no Render como o serviço sentinel-signals-api):
#   FIREBASE_SERVICE_ACCOUNT_JSON  — mesma service account acima
#   TELEGRAM_BOT_TOKEN             — mesmo bot do canal 24h
#   TELEGRAM_CHAT_ID               — mesmo chat_id do canal 24h (usado por /webhook/tradingview)
#   ALLOWED_ORIGIN                 — origin exato permitido no CORS (nunca '*' em produção)
#   WEBHOOK_SECRET                 — token que o Pine Script (input "Webhook Secret",
#                                    Grupo 10) precisa enviar em cada alerta; gere um
#                                    valor forte e configure o MESMO no TradingView
#   GITHUB_ACTIONS_TOKEN           — PAT fine-grained do GitHub, escopado SÓ ao
#                                    repositório Sentinel-Signals, permissão
#                                    "Actions: Read and write" e nada mais. Usado
#                                    por /api/backtest/{trigger,status,artifact}
#                                    para disparar/ler o workflow backtest.yml
#                                    pelo painel. Sem isso, essas rotas respondem
#                                    503 — o resto do servidor funciona normalmente.
#   PORT                           — porta do servidor (default 3000)
