rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Business collections: single-tenant app behind login — any authenticated
    // user may read/write, mirroring the original Base44 admin/user model.
    match /monitoredAssets/{docId} {
      allow read, write: if isSignedIn();
    }

    match /assetStates/{docId} {
      allow read, write: if isSignedIn();
    }

    match /signalEvents/{docId} {
      allow read, write: if isSignedIn();
    }

    match /tradeOperations/{docId} {
      allow read, write: if isSignedIn();
    }

    match /priceAlerts/{docId} {
      allow read, write: if isSignedIn();
    }

    match /systemLogs/{docId} {
      allow read, write: if isSignedIn();
    }

    // Verification tasks: reminder created automatically when the scanner
    // detects a high-priority signal (persistScanResults, scanner.js) so a
    // human review never gets lost — see src/pages/Verification.jsx and
    // src/components/dashboard/VerificationWidget.jsx.
    match /verificationTasks/{docId} {
      allow read, write: if isSignedIn();
    }

    // Scanner concurrency lock: prevents the browser auto-scan and the
    // GitHub Actions cron from processing the same batch at the same time.
    match /scannerLocks/{lockName} {
      allow read, write: if isSignedIn();
    }

    // Tracks the single active TradeOperation per asset (if any), so the
    // create-if-none-active check can be a single-document transactional
    // read instead of a query (Firestore transactions can't read queries).
    match /assetActiveOps/{assetId} {
      allow read, write: if isSignedIn();
    }

    // Strategy parameters (minScore, tp1R, tp1QtyPercent, trailAtrMult) kept
    // in sync between the in-browser Pine Script editor and the 24/7 cron.
    match /strategyConfig/{docId} {
      allow read, write: if isSignedIn();
    }

    // Telegram signal-source filter (RF/SMC/MACD/EMA Cross/RSI), kept in sync
    // between the in-browser Settings and the 24/7 cron the same way
    // strategyConfig is — see src/lib/telegram.js and scripts/adminTelegram.js.
    match /telegramFilters/{docId} {
      allow read, write: if isSignedIn();
    }

    // User profiles: a user may read/create their own profile, but cannot
    // grant themselves the admin role or edit anyone else's profile.
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'user';
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == resource.data.role;
    }

    // Strategy Reviewer chat: a user may read/create their own conversations.
    // Messages are always denied client-side writes below (Strategy Reviewer
    // is paused — src/pages/StrategyReviewer.jsx is a placeholder, and this
    // project has no Cloud Functions/Blaze, permanent restriction — so
    // nothing writes here today; this rule just guarantees nobody could
    // spoof a reply if/when a server-side writer using the Admin SDK, which
    // bypasses these rules, is ever built). docs/known-risks.md item 80, D-5.
    match /agentConversations/{convId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isSignedIn()
          && get(/databases/$(database)/documents/agentConversations/$(convId)).data.user_id == request.auth.uid;
        allow write: if false;
      }
    }

    // Telegram delivery config: only the chat_id destination lives here (the
    // bot token is an app-level Cloud Functions secret, never stored per-user).
    match /telegramConfig/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
