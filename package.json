{
  "name": "sentinel-signals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "test": "vitest run",
    "preview": "vite preview",
    "build:scan": "node scripts/build-scan.mjs",
    "scan": "npm run build:scan && node scripts/dist/run-scan.mjs",
    "build:scan-shadow": "node scripts/build-scan-shadow.mjs",
    "scan:shadow": "npm run build:scan-shadow && node scripts/dist/run-scan-shadow.mjs",
    "build:backtest": "node scripts/build-backtest.mjs",
    "backtest": "npm run build:backtest && node scripts/dist/run-backtest.mjs",
    "build:backfill": "node scripts/build-backfill.mjs",
    "backfill-check": "npm run build:backfill && node scripts/dist/run-backfill-check.mjs",
    "health-audit": "node scripts/health-audit.mjs",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=json-summary --coverage.include='src/**/*.{js,jsx}' --coverage.include='scripts/**/*.{js,mjs}' --coverage.include='server/**/*.js' --coverage.exclude='**/*.test.*' --coverage.exclude='**/__fixtures__/**' --coverage.exclude='scripts/dist/**' --coverage.exclude='src/components/ui/**'",
    "typecheck:ratchet": "node scripts/typecheck-ratchet.mjs",
    "analyze-backtest": "node scripts/analyze-backtest.mjs",
    "analyze-shadow-rf1h": "node scripts/analyze-shadow-rf1h.mjs",
    "backfill-rtdb": "node scripts/backfill-rtdb.mjs"
  },
