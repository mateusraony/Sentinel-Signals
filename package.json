    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "esbuild": "^0.28.1",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "firebase-admin": "^14.1.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
